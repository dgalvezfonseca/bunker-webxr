<style>
  .station {
    flex-direction: column;
    width: 320px;
  }

  .content {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 18px;
    padding-right: 18px;
  }

  .eyebrow {
    color: #287d84;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .title {
    color: #202a34;
    font-size: 22px;
    font-weight: 700;
    line-height: 25px;
    margin-top: 5px;
  }

  .body {
    color: #374554;
    font-size: 14px;
    font-weight: 500;
    line-height: 19px;
    margin-top: 10px;
    width: 100%;
  }

  .status {
    background-color: #dceff0;
    color: #1f5f64;
    font-size: 12px;
    font-weight: 700;
    line-height: 16px;
    margin-top: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    width: 100%;
  }

  .button {
    justify-content: flex-start;
    margin-left: 18px;
    margin-right: 18px;
    margin-top: 12px;
  }

  .guide {
    justify-content: flex-start;
    margin-left: 18px;
    margin-right: 18px;
    margin-top: 8px;
    margin-bottom: 16px;
  }
</style>
<Panel class="station">
  <div class="content">
    <div id="station-number" class="eyebrow">ESTACION 01</div>
    <div id="station-title" class="title">Punto informativo</div>
    <Divider></Divider>
    <div id="station-body" class="body">Informacion de la estacion.</div>
    <div id="station-status" class="status">Demostracion disponible.</div>
  </div>
  <Button id="demo-button" class="button">
    <ButtonLabel id="demo-label">Ver demostracion</ButtonLabel>
  </Button>
  <Button id="guide-button" class="guide">
    <ButtonLabel id="guide-label">Continuar recorrido</ButtonLabel>
  </Button>
</Panel>
